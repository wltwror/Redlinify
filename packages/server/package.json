{
  "name": "@redlinify/server",
  "version": "0.1.0",
  "description": "Redlinify CLI, stdio MCP server, and local HTTP/WebSocket workbench server.",
  "license": "MIT",
  "author": "Vojtěch Faltus",
  "keywords": [
    "redlinify",
    "mcp",
    "cli",
    "architecture",
    "diagrams"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "redlinify": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@redlinify/shared": "0.1.0",
    "chokidar": "^4.0.3",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14"
  }
}
