{
  "name": "@redlinify/server",
  "version": "0.2.1",
  "description": "Redlinify CLI, stdio MCP server with auto-UI launcher, and local HTTP/WebSocket workbench server.",
  "homepage": "https://github.com/wltwror/Redlinify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wltwror/Redlinify.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/wltwror/Redlinify/issues"
  },
  "license": "MIT",
  "author": "Vojtěch Faltus",
  "keywords": [
    "redlinify",
    "mcp",
    "cli",
    "architecture",
    "diagrams"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "redlinify": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@redlinify/shared": "0.2.1",
    "chokidar": "^4.0.3",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14"
  }
}
